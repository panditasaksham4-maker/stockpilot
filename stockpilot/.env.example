# =====================================================================
# StockPilot - Environment Configuration Template
# Copy this file to '.env' and fill in appropriate values for your deployment.
# NEVER commit the real '.env' file containing secrets to version control.
# =====================================================================

# Server Networking
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SQLite Storage Configuration
# Local Development: ./data/stockpilot.db
# Render Persistent Disk Mount: /var/data/stockpilot.sqlite
DATABASE_PATH=/var/data/stockpilot.sqlite

# Session Security
# Generate a cryptographically strong random string (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_production_session_secret_change_me
SESSION_MAX_AGE_MS=86400000

# Initial Super Administrator Bootstrap (Optional for fresh installations)
# If no Super Administrator exists, these values will be used to initialize the first account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_FULL_NAME=System Administrator

# Inventory System Defaults
DEFAULT_LOW_STOCK_THRESHOLD=10
